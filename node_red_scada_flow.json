  },
  {
    "id": "n2",
    "type": "function",
    "z": "t1",
    "name": "Razdvoji vrijednosti",
    "func": "// Ulazni JSON: {device, ts_ms, vibration_mms, current_a}\nconst p = msg.payload;\n\nconst msgVib = { payload: p.vibration_mms };\nconst msgCur = { payload: p.current_a };\nconst msgAlarm = { payload: p };\n\n// Tri izlaza: [vibracija, struja, provjera alarma]\nreturn [msgVib, msgCur, msgAlarm];",
    "outputs": 3,
    "noerr": 0,
    "x": 400,
    "y": 100,
    "wires": [["n3", "n4"], ["n5", "n6"], ["n7"]]
  },
