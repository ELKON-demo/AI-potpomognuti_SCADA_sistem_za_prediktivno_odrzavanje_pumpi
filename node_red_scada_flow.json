  {
    "id": "n7",
    "type": "function",
    "z": "t1",
    "name": "Provjeri alarm pragove",
    "func": "const p = msg.payload;\n\n// Klasicni SCADA prag alarmi - ovo je \"tvrda\" granica.\n// AI sloj (koji dodajemo kasnije) uci normalne obrasce i\n// moze da detektuje anomalije I PRIJE nego sto se predju\n// ovi klasicni pragovi - to je razlika koju treba istaci.\nconst VIB_PRAG = 8.0;      // mm/s\nconst STRUJA_PRAG = 10.0;  // A\n\nlet status = 'NORMALAN RAD';\nlet alarm = false;\n\nif (p.vibration_mms > VIB_PRAG || p.current_a > STRUJA_PRAG) {\n    status = 'UPOZORENJE - MOGUCA ANOMALIJA';\n    alarm = true;\n}\n\nmsg.payload = status;\nmsg.alarm = alarm;\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "x": 420,
    "y": 220,
    "wires": [["n8", "n9"]]
  },
  {
    "id": "n8",
    "type": "ui_text",
    "z": "t1",
    "group": "ug1",
    "order": 5,
    "width": 0,
    "height": 0,
    "name": "Status pumpe (tekst)",
    "label": "Status pumpe",
    "format": "{{msg.payload}}",
    "layout": "row-spread",
    "x": 660,
    "y": 320,
    "wires": []
  },
  {
    "id": "n9",
    "type": "function",
    "z": "t1",
    "name": "Detektuj promjenu statusa",
    "func": "// Salje notifikaciju SAMO u trenutku prelaska iz\n// normalnog rada u alarm (edge detection), ne na svaku poruku\nconst prethodni = context.get('prethodniAlarm') || false;\nconst trenutni = msg.alarm;\n\ncontext.set('prethodniAlarm', trenutni);\n\nif (trenutni === true && prethodni === false) {\n    msg.payload = 'UPOZORENJE: Detektovana anomalija na pumpi 1!';\n    return msg;\n}\nreturn null;",
    "outputs": 1,
    "noerr": 0,
    "x": 440,
    "y": 380,
    "wires": [["n10"]]
  },
